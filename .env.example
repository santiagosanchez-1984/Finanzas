# Google Cloud — Service Account para leer/escribir la planilla
GOOGLE_CLIENT_EMAIL=nombre@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY_ID=...
# Private key completa en base64 (evita problemas de saltos de linea en .env)
# Generarla con: node -e "console.log(Buffer.from(require('./key.json').private_key).toString('base64'))"
GOOGLE_PRIVATE_KEY=...

# ID de la planilla de Google Sheets
SHEET_ID=tu_sheet_id_aqui

# Login con Google (OAuth2) — mismo patron que el proyecto COA
AUTH_SECRET=una_clave_secreta_random_larga
GOOGLE_CLIENT_ID=obtener-en-console.cloud.google.com
GOOGLE_CLIENT_SECRET=obtener-en-console.cloud.google.com
# Primer usuario (admin) sembrado automaticamente en la hoja "Usuarios" la
# primera vez que alguien intenta loguearse y la hoja esta vacia.
ADMIN_EMAIL=tu-email@gmail.com
ADMIN_NOMBRE=Tu Nombre

# Modulo Facturas IVA — Gemini API (gratis, generar en https://aistudio.google.com/apikey)
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-lite-latest

# ID de la carpeta de Drive con las facturas (compartida como Lector con
# GOOGLE_CLIENT_EMAIL de arriba). Es el segmento despues de /folders/ en la URL.
FACTURAS_DRIVE_FOLDER_ID=tu_folder_id_aqui

# Modulo Quincho — planilla propia (compartida como Editor con GOOGLE_CLIENT_EMAIL)
QUINCHO_SHEET_ID=tu_quincho_sheet_id_aqui
# Carpeta de Drive donde se suben las fotos de materiales (compartida como
# Editor, no solo Lector, porque la app sube archivos ahi).
QUINCHO_MATERIALES_FOLDER_ID=tu_folder_id_aqui
# Carpeta de Drive donde se suben los comprobantes de pago (transferencias,
# etc.), compartida como Editor.
QUINCHO_PAGOS_FOLDER_ID=tu_folder_id_aqui
# Refresh token OAuth de tu cuenta personal (NO del service account — los
# service accounts no tienen cuota de Drive propia). Se genera una unica vez
# visitando /api/oauth?action=drive-start con el server corriendo y pegando
# el valor que devuelve.
GOOGLE_DRIVE_REFRESH_TOKEN=...

# Modulo Alquiler — planilla propia (compartida como Editor con GOOGLE_CLIENT_EMAIL).
# Los datos van a la hoja "BD"; las pestañas por año (2023, 2024...) se importan con el boton del modulo.
ALQUILER_SHEET_ID=1gN-xSOwULVCCQJvY_zmuaDBElo-Os-bZa74ey4k1gXU
# Carpeta de Drive para los comprobantes de pago del alquiler (la sube la cuenta
# personal via GOOGLE_DRIVE_REFRESH_TOKEN, igual que Quincho).
ALQUILER_COMPROBANTES_FOLDER_ID=tu_folder_id_aqui
